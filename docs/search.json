---
layout: compress
---
[
  {% for post in site.posts %}
    {
      "title": {{ post.title | jsonify }},
      "tags": {{ post.tags | join: ', ' | jsonify }},
      "url": {{ post.url | relative_url | jsonify }},
      "date": {{ post.date | date: '%Y.%m.%d' | jsonify }},
      "description": {{ post.description | strip_newlines | strip_html | strip | jsonify }},
      "content": {{ post.content | truncate: 300 | strip_html | strip_newlines | strip | jsonify }},
      "image": {{ post.post-image | jsonify }},
      "readtime": {{ post.content | number_of_words | divided_by: 180 | plus: 1 | jsonify }}
    }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
